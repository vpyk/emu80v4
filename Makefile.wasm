EMCC = em++
SRC_DIR = src
OUTPUT = emuframe

# make -f Makefile.wasm DBG=1 builds the variant with external debugger support
ifeq ($(DBG),1)
OBJ_DIR = obj_wasm_dbg
BUILD_DIR = build_wasm_dbg
else
OBJ_DIR = obj_wasm
BUILD_DIR = build_wasm
endif

.PHONY: all

SOURCES := $(wildcard $(SRC_DIR)/*.cpp) $(wildcard $(SRC_DIR)/3rdparty/z80/*.cpp) \
           $(wildcard $(SRC_DIR)/sdl/*.cpp) $(wildcard $(SRC_DIR)/lite/*.cpp) \
           $(wildcard $(SRC_DIR)/wasm/*.cpp)
SOURCES := $(filter-out $(SRC_DIR)/sdl/sdlPalFile.cpp, $(SOURCES))
ifneq ($(DBG),1)
SOURCES := $(filter-out $(SRC_DIR)/wasm/wasmDbgCalls.cpp, $(SOURCES))
endif

TARGETS := $(BUILD_DIR)/$(OUTPUT).js $(BUILD_DIR)/$(OUTPUT).wasm

PRE_JS := $(SRC_DIR)/wasm/prejs.js
SRC_WEB_FILES := index.html emu80.js emuframe.html dummyframe.html const.js emu80.css readme.txt

EMFLAGS := -c -g2 -O3 -std=c++11 -DPAL_SDL -DPAL_LITE -DPAL_WASM -sUSE_SDL=2 -I$(SRC_DIR)/3rdparty
LDFLAGS := -sUSE_SDL=2 -sASSERTIONS=0 -sFETCH=1 -sASYNCIFY=1  -sASYNCIFY_STACK_SIZE=16384 --pre-js $(PRE_JS)

ifeq ($(DBG),1)
EMFLAGS += -DWASM_DBG
LDFLAGS += -sEXPORTED_RUNTIME_METHODS=['ccall','getValue','HEAPU8','HEAPU16','HEAP32'] -sEXPORTED_FUNCTIONS=['_main','_malloc','_free']
else
LDFLAGS += -sEXPORTED_RUNTIME_METHODS=ccall
endif

OBJECTS := $(patsubst $(SRC_DIR)/%,$(OBJ_DIR)/%,$(SOURCES:.cpp=.o))
DEPENDS := $(patsubst $(SRC_DIR)/%,$(OBJ_DIR)/%,$(SOURCES:.cpp=.d))

SRC_WEB_FILES := $(foreach file,$(SRC_WEB_FILES),$(SRC_DIR)/wasm/web/$(file))
WEB_FILES := $(foreach file,$(SRC_WEB_FILES),$(BUILD_DIR)/$(notdir $(file)))

all: $(TARGETS) $(WEB_FILES)

# The linker produces both .js and .wasm in one run
$(BUILD_DIR)/$(OUTPUT).js: $(OBJECTS)
	@mkdir -p $(dir $@)
	$(EMCC) $(OBJECTS) $(LDFLAGS) -o $@

$(BUILD_DIR)/$(OUTPUT).wasm: $(BUILD_DIR)/$(OUTPUT).js ;

$(OBJECTS): $(OBJ_DIR)/%.o: $(SRC_DIR)/%.cpp $(OBJ_DIR)/%.d
	$(EMCC) $(EMFLAGS) $< -o $@

$(DEPENDS): $(OBJ_DIR)/%.d: $(SRC_DIR)/%.cpp
	@mkdir -p $(dir $@)
	$(EMCC) -MM -MP -MT"$(@:.d=.o)" $(EMFLAGS) $< > $@

$(WEB_FILES): $(BUILD_DIR)/%: $(SRC_DIR)/wasm/web/%
	@mkdir -p $(BUILD_DIR)
	cp -f $< $@

clean:
	-rm -f $(OBJECTS) $(DEPENDS) $(TARGETS) $(WEB_FILES)

-include $(DEPENDS)
