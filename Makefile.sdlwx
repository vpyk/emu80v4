#!/usr/bin/make -f

SRC_DIR = src
OBJ_DIR = obj_sdlwx
BUILD_DIR = build_sdlwx
TARGET = $(BUILD_DIR)/Emu80
INSTALLDIR = ~/emu80

ifeq ($(origin CXX),default)
CXX = c++
endif
CXXFLAGS ?= -O2 -Wall

# Mandatory flags are kept separately, so overriding CXXFLAGS doesn't drop them
EMU_CXXFLAGS := -std=c++11 $(shell wx-config --cflags) $(shell sdl2-config --cflags) -DPAL_SDL -DPAL_WX -I$(SRC_DIR)/3rdparty
LDLIBS := $(shell sdl2-config --libs) $(shell wx-config --libs) -lGL

SOURCES := $(wildcard $(SRC_DIR)/*.cpp $(SRC_DIR)/sdl/*.cpp $(SRC_DIR)/wx/*.cpp $(SRC_DIR)/3rdparty/z80/*.cpp)
OBJECTS := $(patsubst $(SRC_DIR)/%.cpp,$(OBJ_DIR)/%.o,$(SOURCES))
DEPENDS := $(OBJECTS:.o=.d)

.PHONY: all clean install

all: $(TARGET)

$(TARGET): $(OBJECTS)
	@mkdir -p $(@D)
	$(CXX) $(LDFLAGS) $(OBJECTS) $(LDLIBS) -o $@

$(OBJ_DIR)/%.o: $(SRC_DIR)/%.cpp
	@mkdir -p $(@D)
	$(CXX) $(CPPFLAGS) $(EMU_CXXFLAGS) $(CXXFLAGS) -MMD -MP -c $< -o $@

clean:
	rm -rf $(OBJ_DIR) $(BUILD_DIR)

install: $(TARGET)
	mkdir -p $(INSTALLDIR)
	cp $(TARGET) $(INSTALLDIR)
	cp -r dist/* $(INSTALLDIR)
	cp COPYING.txt $(INSTALLDIR)
	cp whatsnew.txt $(INSTALLDIR)
	cp -r doc/* $(INSTALLDIR)

-include $(DEPENDS)
